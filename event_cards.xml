<?xml version="1.0" encoding="UTF-8"?>
<!--
  카러플 인포 앱 홈 화면에 뜨는 이벤트 카드 목록입니다.
  - 각 <event> 하나가 카드 한 장입니다. 여러 장을 넣으면 홈 화면에서 좌우로 넘겨 볼 수 있어요.
  - startAt ~ endAt 구간에 "지금"이 들어있는 카드만 화면에 보입니다. 구간이 지났거나 아직 안 왔으면 자동으로 숨겨져요.
  - 날짜는 꼭 UTC 기준(끝에 Z)으로 "yyyy-MM-ddTHH:mm:ssZ" 형식으로 적어주세요.
    한국 시간(KST)은 UTC보다 9시간 빠르므로, 예를 들어 한국 시간 10월 25일 00:00 은 UTC로 10월 24일 15:00 (2026-10-24T15:00:00Z) 입니다.
  - imageUrl, linkUrl, backgroundColor 는 전부 선택 사항입니다 — 없으면 그냥 안 쓰시면 돼요.
  - id는 카드끼리만 서로 다르면 되고, 화면에는 안 보입니다.
-->
<events>

    <!-- 예시 1: 이미지 없이 글자와 배경색만 쓰는 가장 단순한 카드 -->
    <event>
        <id>test_banner_1</id>
        <title>테스트 배너 1</title>
        <subtitle>현재 배포를 준비중인 앱의 테스트 배너입니다.</subtitle>
        <backgroundColor>#FFFFFF</backgroundColor>
        <startAt>2026-10-09T00:00:00Z</startAt>
        <endAt>2026-10-20T23:59:59Z</endAt>
    </event>

    <!-- 예시 2: 배경 이미지 + 누르면 외부 페이지로 연결되는 카드 -->
    <event>
        <id>test_banner_2</id>
        <title>테스트 배너 2</title>
        <subtitle>배경 이미지가 있고, 배너 클릭 시 외부 페이지로 연결</subtitle>
        <imageUrl>https://nxm-mt.akamaized.net/Contents/kartrush.nexon.com/launching/images_9B452F71D3CCA09B/sns_thumb-kr.jpg</imageUrl>
        <linkUrl>https://forum.nexon.com/kart_rush/board_view?board=1420&amp;thread=0</linkUrl>
        <startAt>2026-10-09T00:00:00Z</startAt>
        <endAt>2026-11-01T23:59:59Z</endAt>
    </event>

    <!-- 예시 3: 연말 업데이트 예고 (아직 시작 전인 날짜 예시 — 2026-12-01 전까지는 안 보임) -->
    <event>
        <id>2026_app_open_banner</id>
        <title>KRRP 정보 앱 출시!</title>
        <subtitle>다양한 기능을 모아둔 KRRP 정보 앱이 출시되었습니다!</subtitle>
        <backgroundColor>#1E6F5C</backgroundColor>
        <startAt>2026-10-14T00:00:00Z</startAt>
        <endAt>2026-12-31T23:59:59Z</endAt>
    </event>

</events>
